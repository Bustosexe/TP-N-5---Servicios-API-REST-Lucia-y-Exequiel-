@page "/catalogo"
@using GestorComercial_Movil.Models
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="container-fluid pt-3 pb-5" style="background-color: #F8F9FA; min-height: 100vh;">
    <!-- Encabezado superior -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-box-fill text-primary fs-3 me-2"></i>
            <div>
                <small class="text-primary fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">NEXLEDGER API</small>
                <h5 class="fw-bold mb-0 text-dark">Inventario</h5>
            </div>
        </div>
        <div class="d-flex gap-3 text-secondary fs-5">
            <i class="bi bi-search"></i>
            <i class="bi bi-bell"></i>
            <img src="https://ui-avatars.com/api/?name=Alejandro&background=random" class="rounded-circle" width="30" alt="Avatar">
        </div>
    </div>

    <!-- Lista de Productos -->
    @if (productos == null)
    {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
                <p class="text-muted mt-2">Cargando inventario...</p>
            </div>
    }
    else
    {
            <div class="pb-5 mb-5"> <!-- Espacio extra para el botón flotante y el menú inferior -->
            @foreach (var prod in productos)
            {
                        <div class="card border-0 shadow-sm rounded-4 mb-3">
                            <div class="card-body p-3">
                                <div class="d-flex gap-3">
                                    <!-- Imagen -->
                                    <div style="width: 80px; height: 80px; flex-shrink: 0;">
                                        <img src="@(string.IsNullOrEmpty(prod.ImagenUrl) ? "https://via.placeholder.com/80" : $"https://tu-dominio-monster.com{prod.ImagenUrl}")" 
                                             class="w-100 h-100 rounded-3" style="object-fit: cover;" alt="@prod.Nombre">
                                    </div>

                                    <!-- Detalles -->
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <small class="text-primary fw-bold" style="font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase;">
                                                Categoría ID: @prod.CategoriaId
                                            </small>

                                            <!-- Etiqueta de Stock Dinámica -->
                                    @if (prod.Stock > 5)
                                    {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1" style="font-size: 0.65rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>@prod.Stock en stock</span>
                                    }
                                    else if (prod.Stock > 0 && prod.Stock <= 5)
                                    {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1" style="font-size: 0.65rem;">@prod.Stock restantes</span>
                                    }
                                    else
                                    {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1" style="font-size: 0.65rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>Agotado</span>
                                    }
                                        </div>

                                        <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">@prod.Nombre</h6>

                                        <div class="d-flex align-items-center mb-2">
                                            <small class="text-muted" style="font-size: 0.7rem;">SKU: PRD-@(prod.Id.ToString("D3"))</small>
                                            <span class="mx-2 text-muted" style="font-size: 0.5rem;">•</span>
                                            <small class="text-muted" style="font-size: 0.7rem;">Depósito Central</small>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-end mt-2">
                                            <div>
                                                <small class="text-muted d-block" style="font-size: 0.7rem;">Precio unitario</small>
                                                <h5 class="fw-bold text-dark mb-0">$@prod.Precio.ToString("N2") <small class="text-muted" style="font-size: 0.7rem;">USD</small></h5>
                                            </div>

                                            <!-- Botones de Acción -->
                                            <div class="d-flex gap-2">
                                        @if (prod.Stock > 0)
                                        {
                                                        <button class="btn btn-light text-secondary rounded-3 px-2 py-1 border shadow-sm"><i class="bi bi-clock-history"></i></button>
                                                        <button class="btn btn-primary rounded-3 px-2 py-1 shadow-sm" style="background-color: #5B4EFA; border: none;"><i class="bi bi-pencil-fill"></i></button>
                                        }
                                        else
                                        {
                                                        <button class="btn btn-primary bg-opacity-10 text-primary rounded-3 px-3 py-1 shadow-sm border-0 fw-bold" style="font-size: 0.8rem;">
                                                            <i class="bi bi-truck me-1"></i> Reordenar
                                                        </button>
                                        }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
            }
            </div>
    }

    <!-- Botón Flotante Central -->
    <div class="position-fixed" style="bottom: 80px; left: 50%; transform: translateX(-50%); z-index: 1040;">
        <button class="btn btn-primary rounded-pill px-4 py-2 shadow-lg fw-bold d-flex align-items-center gap-2" style="background-color: #5B4EFA; border: none;">
            <i class="bi bi-plus-lg"></i> Nuevo Producto
        </button>
    </div>
</div>

@code {
    private List<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PaginacionResponse<Producto>>("Productos?page=1&pageSize=50");
            if (response?.Items != null)
            {
                productos = response.Items;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar productos: " + ex.Message);
        }
    }
}