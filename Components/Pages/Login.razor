@page "/login"
@layout EmptyLayout
@inject NavigationManager NavManager
@inject HttpClient Http

<!-- Usamos EmptyLayout (si lo tienes) para ocultar la barra de navegación inferior en esta pantalla -->

<div class="container-fluid d-flex flex-column align-items-center py-4" style="background-color: #F4F7FB; min-height: 100vh;">

    <!-- Insignias de Seguridad Superiores -->
    <div class="d-flex gap-2 mb-4 w-100 justify-content-center">
        <span class="badge bg-white text-secondary shadow-sm rounded-pill px-3 py-2 border border-light" style="font-size: 0.65rem; letter-spacing: 1px;">
            <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.4rem;"></i> GATEWAY ONLINE • EU-CENTRAL
        </span>
        <span class="badge bg-white text-success shadow-sm rounded-pill px-3 py-2 border border-light" style="font-size: 0.65rem; font-family: monospace;">
            <i class="bi bi-lock-fill me-1"></i> 256-bit SSL
        </span>
    </div>

    <!-- Logo y Título -->
    <div class="text-center mb-4">
        <div class="bg-white rounded-4 shadow-sm d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
            <i class="bi bi-diagram-3-fill fs-2" style="color: #5B4EFA;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-0">NexLedger</h3>
        <small class="text-muted">Gestión Comercial B2B</small>
    </div>

    <!-- Tarjeta Principal del Formulario -->
    <div class="card border-0 shadow-sm rounded-4 w-100 mb-4" style="max-width: 400px;">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-1">Iniciar Sesión</h5>
            <p class="text-muted small mb-4">Accede a tu panel comercial e inventario</p>

            <EditForm Model="@loginModel" OnValidSubmit="ProcesarLogin">
                <DataAnnotationsValidator />

                <!-- Input: Email -->
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold" style="font-size: 0.8rem;">Email corporativo</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-envelope"></i></span>
                        <InputText class="form-control bg-transparent border-0 shadow-none" placeholder="nombre@empresa.com" @bind-Value="loginModel.Email" />
                    </div>
                </div>

                <!-- Input: Contraseña -->
                <div class="mb-3">
                    <label class="form-label text-dark fw-bold" style="font-size: 0.8rem;">Contraseña</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-lock"></i></span>
                        <InputText type="@(mostrarPassword ? "text" : "password")" class="form-control bg-transparent border-0 shadow-none" placeholder="••••••••••••" @bind-Value="loginModel.Password" />
                        <button type="button" class="btn btn-light bg-transparent border-0 text-muted pe-3" @onclick="TogglePassword">
                            <i class="bi @(mostrarPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <!-- Checkbox: Recordar Dispositivo -->
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="recordar" style="background-color: #5B4EFA; border-color: #5B4EFA;">
                    <label class="form-check-label text-muted" for="recordar" style="font-size: 0.8rem;">
                        Recordar este dispositivo
                    </label>
                </div>

                <!-- Botón Iniciar Sesión -->
                <button type="submit" class="btn btn-primary w-100 py-3 rounded-4 fw-bold shadow-sm mb-3 d-flex justify-content-center align-items-center gap-2" style="background-color: #5B4EFA; border: none; font-size: 1rem;" disabled="@procesando">
                    @if (procesando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Iniciar Sesión <i class="bi bi-arrow-right ms-1"></i></span>
                    }
                </button>
            </EditForm>

            <!-- Enlaces de Ayuda -->
            <div class="text-center mb-4">
                <a href="#" class="text-decoration-none d-block mb-1" style="font-size: 0.85rem; color: #5B4EFA;">¿Olvidaste tu contraseña?</a>
                <span class="text-muted" style="font-size: 0.85rem;">¿No tienes cuenta? <a href="#" class="text-decoration-none fw-bold" style="color: #5B4EFA;">Regístrate aquí</a></span>
            </div>

            <!-- Divisor -->
            <div class="d-flex align-items-center mb-4">
                <hr class="flex-grow-1 text-muted opacity-25">
                <span class="mx-3 text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">O INICIAR SESIÓN CON</span>
                <hr class="flex-grow-1 text-muted opacity-25">
            </div>

            <!-- Botón de Google -->
            <button class="btn btn-white bg-white border border-primary w-100 py-2 rounded-4 shadow-sm d-flex justify-content-center align-items-center gap-2 text-dark fw-bold" style="border-color: #5B4EFA !important; border-style: dashed !important; font-size: 0.9rem;">
                <i class="bi bi-google text-danger"></i> Continuar con Google
            </button>
        </div>
    </div>

    <!-- Pie de página -->
    <div class="mt-auto text-center w-100">
        <div class="mb-2">
            <small class="text-muted" style="font-size: 0.65rem; font-family: monospace;">NexLedger API v2.4</small>
            <span class="text-muted mx-1">•</span>
            <small class="text-success fw-bold" style="font-size: 0.65rem;"><i class="bi bi-shield-check me-1"></i>Conexión cifrada TLS 1.3</small>
        </div>
        <a href="#" class="text-decoration-none fw-bold mb-2 d-block" style="font-size: 0.75rem; color: #5B4EFA;">Soporte TI</a>
        <small class="text-muted" style="font-size: 0.65rem;">&copy; 2024 NexLedger Logistics Systems Ltd. Todos los derechos reservados.</small>
    </div>
</div>

@code {
    private LoginRequest loginModel = new LoginRequest();
    private bool mostrarPassword = false;
    private bool procesando = false;
    private string mensajeError = "";

    private void TogglePassword()
    {
        mostrarPassword = !mostrarPassword;
    }

    private async Task ProcesarLogin()
    {
        procesando = true;
        mensajeError = "";

        try
        {
            // 1. Hacemos el POST real al endpoint de tu API del TP5
            // Asegúrate de que el modelo coincida con lo que espera tu UsuariosController
            var response = await Http.PostAsJsonAsync("Usuarios/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                // 2. Leemos la respuesta de la API (que debería devolver { "token": "eyJhbG..." })
                var resultado = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (resultado != null && !string.IsNullOrEmpty(resultado.Token))
                {
                    // 3. Guardamos el Token de forma segura en el celular (MAUI SecureStorage)
                    await SecureStorage.Default.SetAsync("jwt_token", resultado.Token);

                    // 4. Redirigimos al Dashboard
                    NavManager.NavigateTo("/");
                }
            }
            else
            {
                // Si la API devuelve 401 Unauthorized o 400 BadRequest
                mensajeError = "Credenciales incorrectas. Verifique su email y contraseña.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión con el servidor: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    // Clases auxiliares para enviar y recibir los datos
    public class LoginRequest
    {
        public string Email { get; set; } = string.Empty;
        // Dependiendo de tu TP5, la variable podría llamarse Password o PasswordHash.
        // Si en tu API lo llamaste PasswordHash, cámbialo aquí:
        public string PasswordHash { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}