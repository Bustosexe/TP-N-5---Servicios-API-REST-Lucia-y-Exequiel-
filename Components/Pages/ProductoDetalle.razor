@page "/producto/{Id:int}"
@using GestorComercial_Movil.Models
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="container-fluid pt-3 pb-5" style="background-color: #F8F9FA; min-height: 100vh;">

    <!-- Cabecera -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
        <button class="btn btn-link text-dark text-decoration-none p-0 d-flex align-items-center fw-bold" @onclick="Volver">
            <i class="bi bi-arrow-left me-2 fs-5"></i> Inventario
        </button>
        <div class="d-flex gap-3 align-items-center">
            <i class="bi bi-pencil fs-5 text-muted"></i>
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; background-color: #5B4EFA !important;">
                <i class="bi bi-person-fill"></i>
            </div>
        </div>
    </div>

    @if (producto == null)
    {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="color: #5B4EFA !important;"></div>
                <p class="text-muted mt-2">Cargando detalles...</p>
            </div>
    }
    else
    {
            <!-- Contenedor de Imagen -->
            <div class="position-relative mb-3">
                <img src="@(string.IsNullOrEmpty(producto.ImagenUrl) ? "https://via.placeholder.com/400x250" : $"https://tu-dominio-monster.com{producto.ImagenUrl}")" 
                     class="w-100 rounded-4 shadow-sm" style="object-fit: cover; height: 220px;" alt="@producto.Nombre" />

                <span class="badge bg-white text-dark position-absolute top-0 start-0 m-3 shadow-sm rounded-pill px-3 py-2" style="font-size: 0.7rem;">
                    <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.4rem;"></i> Activo • Sincronizado API
                </span>

                <button class="btn btn-light position-absolute bottom-0 end-0 m-3 rounded-4 shadow-sm text-muted">
                    <i class="bi bi-images"></i>
                </button>
            </div>

            <!-- Título y Etiquetas -->
            <div class="d-flex justify-content-between align-items-start mb-2 px-1">
                <h4 class="fw-bold text-dark mb-0">@producto.Nombre</h4>
                <small class="text-muted" style="font-size: 0.7rem; font-family: monospace;">v4.2.0</small>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-4 px-1">
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-bold" style="font-size: 0.75rem;">
                    <span class="text-muted fw-normal me-1">SKU:</span> PRD-@producto.Id.ToString("D4")
                </span>
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2" style="font-size: 0.75rem; font-family: monospace;">
                    <i class="bi bi-upc-scan me-1"></i> 779812409821
                </span>

            @if (producto.Stock > 0)
            {
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-check-circle me-1"></i> @producto.Stock en stock
                        </span>
            }
            else
            {
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold" style="font-size: 0.75rem;">
                            <i class="bi bi-x-circle me-1"></i> Agotado
                        </span>
            }
            </div>

            <!-- Métricas Financieras -->
            <div class="row g-2 mb-4">
                <!-- Costo Simulado (Ej: 75% del precio de venta) -->
                <div class="col-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-2 text-center">
                            <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Costo</small>
                            <h6 class="fw-bold text-dark mb-0">$@((producto.Precio * 0.75m).ToString("N0"))</h6>
                            <small class="text-muted" style="font-size: 0.6rem;">.00 USD</small>
                        </div>
                    </div>
                </div>
                <!-- Precio de Venta Real (API) -->
                <div class="col-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 border-primary" style="border-left: 3px solid #5B4EFA !important;">
                        <div class="card-body p-2 text-center">
                            <small class="text-primary d-block mb-1" style="font-size: 0.7rem;">P. Venta</small>
                            <h6 class="fw-bold text-primary mb-0">$@producto.Precio.ToString("N0")</h6>
                            <small class="text-primary opacity-75" style="font-size: 0.6rem;">.00 USD</small>
                        </div>
                    </div>
                </div>
                <!-- Margen Simulado -->
                <div class="col-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-2 text-center">
                            <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Margen</small>
                            <small class="text-success fw-bold d-block" style="font-size: 0.75rem;"><i class="bi bi-arrow-up-right"></i> +25.0%</small>
                            <small class="text-success opacity-75" style="font-size: 0.65rem;">+$@((producto.Precio * 0.25m).ToString("N0"))</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ubicación Físca & Stock (Simulado para UI) -->
            <div class="card border-0 shadow-sm rounded-4 mb-5 pb-5">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold text-primary mb-0" style="color: #5B4EFA !important;"><i class="bi bi-house-door me-2"></i>Ubicación & Stock</h6>
                        <span class="badge bg-light text-secondary rounded-pill">@producto.Stock Uds. Totales</span>
                    </div>

                    <!-- Almacén Central -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-dark fw-bold"><i class="bi bi-geo-alt text-muted me-1"></i> Almacén Central (CD-1)</small>
                            <span class="fw-bold text-dark">@(Math.Round(producto.Stock * 0.7)) uds</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted" style="font-size: 0.7rem;">Pasillo B, Estante A-12</small>
                            <small class="text-primary fw-bold" style="font-size: 0.7rem;">70.0%</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar rounded-pill" role="progressbar" style="width: 70%; background-color: #5B4EFA;" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Sucursal Norte -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-dark fw-bold"><i class="bi bi-shop text-muted me-1"></i> Sucursal Norte</small>
                            <span class="fw-bold text-dark">@(Math.Round(producto.Stock * 0.2)) uds</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted" style="font-size: 0.7rem;">Rack 04 - Sector C</small>
                            <small class="text-secondary fw-bold" style="font-size: 0.7rem;">20.0%</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-secondary rounded-pill" role="progressbar" style="width: 20%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Tránsito -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-dark fw-bold"><i class="bi bi-truck text-muted me-1"></i> Tránsito / Reserva</small>
                            <span class="fw-bold text-dark">@(Math.Round(producto.Stock * 0.1)) uds</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted" style="font-size: 0.7rem;">Pedido #OC-2024-88</small>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">10.0%</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-light border rounded-pill" role="progressbar" style="width: 10%;" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>

<!-- Panel de Acciones Fijo (Sticky Footer) -->
@if (producto != null)
{
        <div class="position-fixed w-100 p-3 bg-white border-top shadow-lg d-flex gap-2" style="bottom: 65px; left: 0; z-index: 1040; max-width: inherit;">
            <button class="btn btn-light text-secondary rounded-pill shadow-sm fw-bold px-4" style="font-size: 0.9rem;">
                Transferir
            </button>
            <button class="btn btn-primary flex-grow-1 rounded-pill shadow-sm fw-bold" style="background-color: #5B4EFA; border: none; font-size: 0.9rem;" @onclick="IrARegistrarVenta" disabled="@(producto.Stock == 0)">
                Registrar Venta
            </button>
        </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Producto? producto;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Hacemos el fetch al endpoint GET by ID que armaste en tu API
            // Si en tu TP5 no armaste el GET by ID, podemos traer la lista y filtrarlo,
            // pero lo estándar es tener un endpoint "Productos/{Id}".
            var response = await Http.GetFromJsonAsync<Producto>($"Productos/{Id}");
            if (response != null)
            {
                producto = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el producto: {ex.Message}");
        }
    }

    private void Volver()
    {
        NavManager.NavigateTo("/catalogo");
    }

    private void IrARegistrarVenta()
    {
        // En una implementación más avanzada, podríamos pasar el ID por query string
        // NavManager.NavigateTo($"/carrito?productoId={Id}");
        NavManager.NavigateTo("/carrito");
    }
}