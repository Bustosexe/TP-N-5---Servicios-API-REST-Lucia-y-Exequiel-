@page "/ajustes"
@inject NavigationManager NavManager

<div class="container-fluid pt-3 pb-5" style="background-color: #F8F9FA; min-height: 100vh;">
    <!-- Encabezado superior -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary text-white rounded-3 p-2 me-2 d-flex align-items-center justify-content-center" style="background-color: #5B4EFA !important; width: 35px; height: 35px;">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <h5 class="fw-bold mb-0 text-dark">Ajustes</h5>
        </div>
        <div class="d-flex gap-3 text-secondary fs-5 align-items-center">
            <i class="bi bi-bell"></i>
            <img src="https://ui-avatars.com/api/?name=Alejandro&background=random" class="rounded-circle shadow-sm" width="32" alt="Avatar">
        </div>
    </div>

    <!-- Título y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0">Ajustes & Perfil</h4>
        <div class="d-flex gap-2">
            <button class="btn btn-light rounded-circle shadow-sm text-secondary" style="width: 35px; height: 35px;"><i class="bi bi-question-circle"></i></button>
            <button class="btn btn-light rounded-circle shadow-sm text-secondary" style="width: 35px; height: 35px;"><i class="bi bi-qr-code-scan"></i></button>
        </div>
    </div>

    <!-- Tarjeta de Perfil -->
    <div class="text-center mb-4">
        <div class="position-relative d-inline-block mb-3">
            <img src="https://ui-avatars.com/api/?name=Nombre+Usuario&background=E5E7EB&color=374151&size=100" class="rounded-circle shadow-sm border border-3 border-white" alt="Perfil">
            <button class="btn btn-primary rounded-circle position-absolute bottom-0 end-0 p-1 shadow-sm" style="background-color: #5B4EFA; border: none; width: 30px; height: 30px;">
                <i class="bi bi-camera-fill small"></i>
            </button>
        </div>
        <h4 class="fw-bold text-dark mb-0">Nombre Usuario</h4>
        <small class="text-muted d-block mb-2" style="font-size: 0.8rem; font-family: monospace;">nombre.ejemplo@nexledger.com</small>

        <div class="d-flex justify-content-center gap-2 mt-2">
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2" style="color: #5B4EFA !important; font-size: 0.75rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i> Administrador</span>
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-2" style="font-size: 0.75rem; font-family: monospace;">ID: ADM-0492</span>
        </div>
    </div>

    <!-- Estado de Sesión -->
    <div class="bg-white rounded-4 shadow-sm border border-light p-3 mb-4 d-flex justify-content-between align-items-center">
        <small class="text-dark fw-bold"><i class="bi bi-circle-fill text-success me-2" style="font-size: 0.5rem;"></i>Sesión Corporativa Segura</small>
        <small class="text-muted" style="font-family: monospace;">Nivel 4</small>
    </div>

    <!-- Menú: Cuenta y Preferencias -->
    <small class="text-muted fw-bold d-block mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">CUENTA Y PREFERENCIAS</small>
    <div class="bg-white rounded-4 shadow-sm border border-light mb-4">
        <div class="d-flex align-items-center p-3 border-bottom">
            <div class="bg-light text-secondary rounded-3 p-2 me-3"><i class="bi bi-person-gear"></i></div>
            <div class="flex-grow-1">
                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Configuración de Cuenta</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Datos personales, credenciales</small>
            </div>
            <i class="bi bi-chevron-right text-muted small"></i>
        </div>
        <div class="d-flex align-items-center p-3 border-bottom">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3" style="color: #5B4EFA !important;"><i class="bi bi-shield-check"></i></div>
            <div class="flex-grow-1 d-flex align-items-center gap-2">
                <div>
                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Privacidad y Seguridad</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">2FA activo, sesiones</small>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill" style="font-size: 0.6rem;">2FA</span>
            </div>
            <i class="bi bi-chevron-right text-muted small"></i>
        </div>
        <div class="d-flex align-items-center p-3">
            <div class="bg-light text-secondary rounded-3 p-2 me-3"><i class="bi bi-bell"></i></div>
            <div class="flex-grow-1">
                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Notificaciones</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Alertas de stock, ventas</small>
            </div>
            <i class="bi bi-circle-fill text-primary small me-2" style="color: #5B4EFA !important; font-size: 0.4rem;"></i>
            <i class="bi bi-chevron-right text-muted small"></i>
        </div>
    </div>

    <!-- Menú: Soporte y Sistema -->
    <small class="text-muted fw-bold d-block mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">SOPORTE Y SISTEMA</small>
    <div class="bg-white rounded-4 shadow-sm border border-light mb-4">
        <div class="d-flex align-items-center p-3 border-bottom">
            <div class="bg-light text-secondary rounded-3 p-2 me-3"><i class="bi bi-headset"></i></div>
            <div class="flex-grow-1">
                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Soporte Técnico</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Tickets, chat 24/7</small>
            </div>
            <i class="bi bi-chevron-right text-muted small"></i>
        </div>
        <div class="d-flex align-items-center p-3">
            <div class="bg-light text-secondary rounded-3 p-2 me-3"><i class="bi bi-code-slash"></i></div>
            <div class="flex-grow-1">
                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">Acerca de la App</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Licencias y arquitectura</small>
            </div>
            <small class="text-muted me-2" style="font-size: 0.7rem; font-family: monospace;">v4.2.0 (Build 890)</small>
            <i class="bi bi-chevron-right text-muted small"></i>
        </div>
    </div>

    <!-- Botón de Cerrar Sesión -->
    <div class="pb-5 mb-4">
        <button class="btn btn-outline-danger w-100 py-3 rounded-4 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2 bg-white" @onclick="CerrarSesion">
            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
        </button>
    </div>
</div>

@code {
    private void CerrarSesion()
    {
        // En el futuro, aquí borraremos el JWT del SecureStorage o LocalStorage
        // y redirigiremos a la pantalla de Login que armaremos a continuación.
        NavManager.NavigateTo("/login");
    }
}