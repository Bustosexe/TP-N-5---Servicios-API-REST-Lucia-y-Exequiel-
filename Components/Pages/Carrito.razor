@page "/carrito"
@using GestorComercial_Movil.Models
@inject HttpClient Http
@inject NavigationManager NavManager

<!-- Fondo oscuro que simula el modal abierto -->
<div class="d-flex align-items-center justify-content-center p-3" style="background-color: #4B5563; min-height: 100vh;">

    <!-- Contenedor principal de la Tarjeta (Modal) -->
    <div class="card border-0 w-100 shadow-lg" style="max-width: 400px; border-radius: 1.25rem;">
        <div class="card-body p-4">

            <!-- Etiqueta superior y botón de cierre -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2" style="font-size: 0.75rem;">
                    <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.4rem;"></i> KARDEX SYNC 
                    <span class="ms-2">TX-#8921</span>
                </span>
                <button class="btn-close text-muted" @onclick="Cancelar"></button>
            </div>

            <!-- Título -->
            <h4 class="fw-bold mb-1 text-dark">Registrar Venta</h4>
            <p class="text-muted small mb-4">Emisión de pedido y descuento automático</p>

            <!-- Dropdown: Producto -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold text-dark mb-0" style="font-size: 0.85rem;">Seleccionar Producto <span class="text-danger">*</span></label>
                    <small class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>En línea</small>
                </div>
                <select class="form-select form-select-lg rounded-3 bg-light border-0 fs-6 text-muted" @onchange="SeleccionarProducto">
                    <option value="0" selected disabled>Elegir producto o SKU...</option>
                    @if (productos != null)
                    {
                        @foreach (var prod in productos)
                        {
                                    <option value="@prod.Id" disabled="@(prod.Stock == 0)">
                                @prod.Nombre - $@prod.Precio
                                    </option>
                        }
                    }
                </select>
                <div class="d-flex justify-content-between mt-1 px-1">
                    <small class="text-success" style="font-size: 0.7rem;"><i class="bi bi-check-circle me-1"></i>Stock en tiempo real: @(productoSeleccionado?.Stock ?? 0) disp.</small>
                    <small class="text-muted" style="font-size: 0.7rem; font-family: monospace;">CD-1 Central</small>
                </div>
            </div>

            <!-- Dropdown: Cliente -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold text-dark mb-0" style="font-size: 0.85rem;">Seleccionar Cliente <span class="text-danger">*</span></label>
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill" style="font-size: 0.7rem;">B2B Tier 1</span>
                </div>
                <select class="form-select form-select-lg rounded-3 bg-light border-0 fs-6 text-muted" @bind="ventaRequest.ClienteId">
                    <option value="0" selected disabled>Elegir cliente o razón social...</option>
                    <option value="1">Consumidor Final</option>
                    <option value="2">Tech Solutions S.A.</option>
                </select>
                <div class="d-flex justify-content-between mt-1 px-1">
                    <small class="text-muted" style="font-size: 0.7rem;">Crédito disponible verificado</small>
                    <small class="text-muted fw-bold" style="font-size: 0.7rem; font-family: monospace;">USD $50,000</small>
                </div>
            </div>

            <!-- Control de Cantidad -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold text-dark mb-0" style="font-size: 0.85rem;">Cantidad <span class="text-danger">*</span></label>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary active rounded-start bg-primary bg-opacity-10 border-0 fw-bold" style="font-size: 0.7rem;">Unidades</button>
                        <button type="button" class="btn btn-sm btn-light border-0 text-muted rounded-end" style="font-size: 0.7rem;">Cajas</button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between bg-light rounded-4 p-2">
                    <button class="btn btn-white bg-white shadow-sm rounded-3 px-3 py-2" @onclick="RestarCantidad" disabled="@(ventaRequest.Cantidad <= 1)">
                        <i class="bi bi-dash fw-bold"></i>
                    </button>

                    <div class="text-center">
                        <h4 class="fw-bold mb-0">@ventaRequest.Cantidad</h4>
                        <small class="text-muted" style="font-size: 0.6rem; letter-spacing: 1px;">DISPONIBLES: @(productoSeleccionado?.Stock ?? 0) UDS</small>
                    </div>

                    <button class="btn btn-white bg-white shadow-sm rounded-3 px-3 py-2" @onclick="SumarCantidad" disabled="@(productoSeleccionado == null || ventaRequest.Cantidad >= productoSeleccionado.Stock)">
                        <i class="bi bi-plus fw-bold"></i>
                    </button>
                </div>
            </div>

            <!-- Recuadro de Subtotal -->
            <div class="bg-primary bg-opacity-10 rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-primary rounded-3 p-2 me-3 text-white" style="background-color: #5B4EFA !important;">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Subtotal estimado</small>
                        <small class="text-dark fw-bold" style="font-size: 0.7rem; font-family: monospace;">Impuestos incl. (19%)</small>
                    </div>
                </div>
                <h4 class="text-primary fw-bold mb-0" style="color: #5B4EFA !important;">$@subtotal.ToString("N2")</h4>
            </div>

            <!-- Alertas de error/éxito -->
            @if (!string.IsNullOrEmpty(mensaje))
            {
                    <div class="alert @(exito ? "alert-success" : "alert-danger") rounded-3 py-2 px-3 small fw-bold text-center mb-3">
                    @mensaje
                    </div>
            }

            <!-- Botones de Acción -->
            <button class="btn w-100 py-3 rounded-pill fw-bold text-white shadow-sm mb-3" style="background-color: #5B4EFA; font-size: 1rem;" @onclick="ConfirmarVenta" disabled="@procesando">
                @if (procesando)
                { 
                        <span class="spinner-border spinner-border-sm me-2"></span> 
                }
                Confirmar Venta <i class="bi bi-check-circle ms-1"></i>
            </button>

            <div class="text-center">
                <a href="#" class="text-muted text-decoration-none" style="font-size: 0.9rem;" @onclick="Cancelar" @onclick:preventDefault>Cancelar</a>
            </div>
        </div>
    </div>
</div>

@code {
    private SalidaProductoRequest ventaRequest = new SalidaProductoRequest { Cantidad = 1 };
    private List<Producto>? productos;
    private Producto? productoSeleccionado;
    private decimal subtotal = 0;
    private bool procesando = false;
    private string mensaje = "";
    private bool exito = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PaginacionResponse<Producto>>("Productos?page=1&pageSize=100");
            if (response?.Items != null)
            {
                productos = response.Items;
            }
        }
        catch (Exception)
        {
            mensaje = "Error al cargar catálogo.";
        }
    }

    private void SeleccionarProducto(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            ventaRequest.ProductoId = id;
            productoSeleccionado = productos?.FirstOrDefault(p => p.Id == id);

            ventaRequest.Cantidad = 1;
            CalcularSubtotal();
        }
    }

    private void SumarCantidad()
    {
        if (productoSeleccionado != null && ventaRequest.Cantidad < productoSeleccionado.Stock)
        {
            ventaRequest.Cantidad++;
            CalcularSubtotal();
        }
    }

    private void RestarCantidad()
    {
        if (ventaRequest.Cantidad > 1)
        {
            ventaRequest.Cantidad--;
            CalcularSubtotal();
        }
    }

    private void CalcularSubtotal()
    {
        if (productoSeleccionado != null)
        {
            subtotal = productoSeleccionado.Precio * ventaRequest.Cantidad;
        }
    }

    private async Task ConfirmarVenta()
    {
        if (ventaRequest.ProductoId == 0 || ventaRequest.ClienteId == 0)
        {
            exito = false;
            mensaje = "Complete los campos obligatorios.";
            return;
        }

        procesando = true;
        mensaje = "";

        try
        {
            var response = await Http.PostAsJsonAsync("SalidasProductos", ventaRequest);

            if (response.IsSuccessStatusCode)
            {
                exito = true;
                mensaje = "¡Venta registrada! Stock actualizado.";

                ventaRequest = new SalidaProductoRequest { Cantidad = 1 };
                productoSeleccionado = null;
                subtotal = 0;
                await OnInitializedAsync();
            }
            else
            {
                exito = false;
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"Operación rechazada: {error}";
            }
        }
        catch (Exception ex)
        {
            exito = false;
            mensaje = $"Error de red: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private void Cancelar() => NavManager.NavigateTo("/");
}