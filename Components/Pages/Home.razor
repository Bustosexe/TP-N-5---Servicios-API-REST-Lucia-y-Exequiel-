@page "/"
@using GestorComercial_Movil.Models
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="container-fluid pt-3 pb-5" style="background-color: #F8F9FA; min-height: 100vh;">
    <!-- Encabezado y Saludo -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill mb-2">
                <i class="bi bi-circle-fill small me-1"></i> API REST Conectada
            </span>
            <h2 class="fw-bold mb-0">Hola, Alejandro</h2>
            <small class="text-muted">Centro de control y flujo de caja en tiempo real</small>
        </div>
        <img src="https://ui-avatars.com/api/?name=Alejandro&background=random" class="rounded-circle shadow-sm" width="45" alt="Avatar">
    </div>

    <!-- Grilla de 4 Métricas -->
    <div class="row g-2 mt-3">
        <!-- Ventas -->
        <div class="col-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-3">
                    <small class="text-muted d-block mb-1">Ventas del Día</small>
                    <h4 class="fw-bold text-dark mb-0">$8,450<small class="text-muted">.00</small></h4>
                    <small class="text-success fw-bold"><i class="bi bi-arrow-up-right"></i> +12.5%</small>
                </div>
            </div>
        </div>
        <!-- Compras -->
        <div class="col-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <small class="text-muted">Compras / Ingr.</small>
                        <i class="bi bi-cart2 text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-0 mt-1">$3,120<small class="text-muted">.00</small></h4>
                    <small class="text-muted" style="font-size: 0.75rem;">4 órdenes procesadas</small>
                </div>
            </div>
        </div>
        <!-- Stock Crítico -->
        <div class="col-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between">
                        <small class="text-muted">Stock Crítico</small>
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">! Alerta</span>
                    </div>
                    <h4 class="fw-bold text-danger mb-0 mt-1">@productosAgotados</h4>
                    <small class="text-muted" style="font-size: 0.75rem;">Requieren reposición</small>
                </div>
            </div>
        </div>
        <!-- Clientes -->
        <div class="col-6">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-3">
                    <small class="text-muted d-block mb-1">Clientes Activos</small>
                    <h4 class="fw-bold text-dark mb-0">142</h4>
                    <small class="text-primary fw-bold" style="font-size: 0.75rem;">+5 hoy</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Operaciones Rápidas -->
    <h6 class="text-muted fw-bold mt-4 mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">OPERACIONES RÁPIDAS</h6>
    <div class="d-flex gap-2 overflow-auto pb-2" style="white-space: nowrap; scrollbar-width: none;">
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="IrAlCarrito">
            <i class="bi bi-plus-circle me-1"></i> Nueva Venta
        </button>
        <button class="btn btn-light bg-white border-0 rounded-pill px-4 text-primary shadow-sm" @onclick="IrAMovimientos">
            <i class="bi bi-box-arrow-in-right me-1"></i> Registrar Ingreso
        </button>
        <button class="btn btn-light bg-white border-0 rounded-pill px-4 text-primary shadow-sm">
            <i class="bi bi-plus-square me-1"></i> Nuevo Producto
        </button>
    </div>

    <!-- Alertas de Stock Mínimo -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h6 class="text-danger fw-bold mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Alertas de Stock Mínimo</h6>
        <a href="catalogo" class="text-primary text-decoration-none small">Ver catálogo</a>
    </div>

    @if (productosAlerta == null)
    {
            <div class="text-center py-3"><div class="spinner-border text-primary spinner-border-sm"></div></div>
    }
    else
    {
        @foreach (var prod in productosAlerta)
        {
                    <div class="card border-0 shadow-sm rounded-4 mb-2">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3">
                                    <i class="bi bi-box text-secondary fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;">@prod.Nombre</h6>
                                    <small class="text-muted d-block">SKU: PRD-0@(prod.Id)</small>
                                    <span class="badge bg-danger bg-opacity-10 text-danger mt-1">@(prod.Stock) disp.</span>
                                </div>
                            </div>
                            <button class="btn btn-light text-primary rounded-pill btn-sm px-3 fw-bold">Pedir</button>
                        </div>
                    </div>
        }
    }

    <!-- Últimos Movimientos -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h6 class="text-dark fw-bold mb-0">Últimos Movimientos</h6>
        <a href="#" class="text-primary text-decoration-none small">Historial completo</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-0">
            <div class="list-group list-group-flush rounded-4">
                <div class="list-group-item d-flex justify-content-between align-items-center p-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 rounded p-2 me-3 text-success">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-dark" style="font-size: 0.9rem;">Venta Cliente #FAC-1042</h6>
                            <small class="text-muted">Carlos Mendoza • 3 items</small>
                        </div>
                    </div>
                    <div class="text-end">
                        <h6 class="text-success fw-bold mb-0">+$340.00</h6>
                        <small class="text-muted" style="font-size: 0.7rem;">Hace 12 min</small>
                    </div>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center p-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 rounded p-2 me-3 text-primary">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-dark" style="font-size: 0.9rem;">Ingreso Distribuidores</h6>
                            <small class="text-muted">OC #9921 • 45 unidades</small>
                        </div>
                    </div>
                    <div class="text-end">
                        <h6 class="text-danger fw-bold mb-0">-$1,200.00</h6>
                        <small class="text-muted" style="font-size: 0.7rem;">Hace 1h</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int productosAgotados = 0;
    private List<Producto>? productosAlerta;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Consultamos la API para traer los productos y calcular las métricas reales
            var responseProductos = await Http.GetFromJsonAsync<PaginacionResponse<Producto>>("Productos?page=1&pageSize=100");
            if (responseProductos != null && responseProductos.Items != null)
            {
                // Contamos los agotados (Stock 0 o menor a 5)
                productosAgotados = responseProductos.Items.Count(p => p.Stock <= 5);

                // Tomamos solo los 3 productos con menos stock para la lista de Alertas
                productosAlerta = responseProductos.Items
                                    .Where(p => p.Stock <= 10)
                                    .OrderBy(p => p.Stock)
                                    .Take(3)
                                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando dashboard: " + ex.Message);
        }
    }

    private void IrAlCarrito() => NavManager.NavigateTo("/carrito");
    private void IrAMovimientos() => NavManager.NavigateTo("/movimientos");
}